{
  "$schema": "./schemas/profile_config.schema.json",
  "displayName": "Your Name",
  "identities": [
    {
      "provider": "github",
      "externalId": "your-github-user-node-id",
      "loginHint": "your-github-login",
      "tokenEnv": "GH_RO_CLASSIC_TOKEN",
      "organizationTokens": [],
      "ignoreOrganizations": [],
      "ignoreRepositories": [
        {
          "externalId": "your-profile-repository-node-id",
          "nameHint": "your-github-login/your-github-login"
        }
      ]
    }
  ],
  "publishTargets": [
    {
      "provider": "github",
      "repositoryId": "your-profile-repository-node-id",
      "repositoryHint": "your-github-login/your-github-login",
      "branch": "main",
      "path": "README.md",
      "tokenEnv": "GH_RW_REPO_TOKEN"
    }
  ],
  "render": {
    "topLanguagesCount": 7,
    "topPublicProjectsCount": 6,
    "lastYearWindowDays": 365
  }
}

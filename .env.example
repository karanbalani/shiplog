# Neon Postgres connection string. Used by `dbmate` and `lib/db.ts`.
DATABASE_URL=postgres://user:password@host:5432/shiplog?sslmode=require

# Classic GitHub PAT used only for ingestion reads.
# Recommended scopes: read:user, read:org, and repo read access if you want private activity coverage.
GITHUB_RO_CLASSIC_TOKEN=ghp_xxx

# Repository-scoped GitHub token used only for README publishing writes.
GITHUB_RW_REPO_TOKEN=github_pat_xxx

# Optional: override the date the daily collector targets (YYYY-MM-DD). Defaults to UTC yesterday.
# COLLECT_DATE=2026-05-07

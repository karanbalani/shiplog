# Neon Postgres connection string. Used by `lib/db.ts` and the dbmate wrapper.
DATABASE_CONNECTION_STRING=postgres://shiplog:password@host:5432/shiplog?sslmode=verify-full

# Classic GitHub PAT used only for ingestion reads.
# Recommended scopes: read:user, read:org, and repo read access if you want private activity coverage.
GH_RO_CLASSIC_TOKEN=ghp_xxx

# Optional: extra read token for an organization configured in shiplog.config.json#collect.accounts[].organizationPatTokens[].
# GH_RO_RESTRICTED_ORG_PAT_TOKEN=github_pat_xxx

# Repository-scoped GitHub token used only for README publishing writes.
GH_RW_REPO_TOKEN=github_pat_xxx

# Optional: bound progressive history runs.
# BACKFILL_MODE=deep
# BACKFILL_REPOSITORY_LIMIT=10
# BACKFILL_MAX_MINUTES=45
